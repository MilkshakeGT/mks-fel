<odoo>
    <template id="report_invoice_fel_custom" inherit_id="account.report_invoice_document">
        <xpath expr="//h2/span[@t-field='o.name']" position="after">
            <div class="row mt4">
                <div class="col-12" style="line-height: 1.2; font-size: 12px;">
                    <p t-if="o.fel_uuid" style="margin: 0;"><strong>Número de autorización SAT:</strong> <span t-esc="o.fel_uuid"/></p>
                    <p t-if="o.serie_fel" style="margin: 0;"><strong>Serie FEL:</strong> <span t-esc="o.serie_fel"/></p>
                    <p t-if="o.numero_fel" style="margin: 0;"><strong>Número FEL:</strong> <span t-esc="o.numero_fel"/></p>
                    <p t-if="o.fechaEmision_fel" style="margin: 0;"><strong>Fecha de Emisión FEL:</strong> <span t-esc="o.fechaEmision_fel"/></p>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
