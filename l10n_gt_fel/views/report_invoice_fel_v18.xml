<odoo>
    <template id="report_invoice_fel_v18" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="before">
            <div class="row mt-3">
                <div class="col-12" style="line-height: 1.2;">
                    <div t-if="o.fel_uuid" style="margin: 0;"><strong>Número de autorización SAT:</strong> <span t-esc="o.fel_uuid"/></div>
                    <div t-if="o.serie_fel" style="margin: 0;"><strong>Serie FEL:</strong> <span t-esc="o.serie_fel"/></div>
                    <div t-if="o.numero_fel" style="margin: 0;"><strong>Número FEL:</strong> <span t-esc="o.numero_fel"/></div>
                    <div t-if="o.fechaEmision_fel" style="margin: 0;"><strong>Fecha de Emisión FEL:</strong> <span t-esc="o.fechaEmision_fel"/></div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
